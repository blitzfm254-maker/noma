# Copy this file to .env and replace the values with your StackHero account settings.
STACKHERO_ACCOUNT_ID=your_account_id
STACKHERO_SECRET_KEY=your_secret_key
# The webhook secret from your StackHero account.
STACKHERO_WEBHOOK_SECRET=your_webhook_secret
# Required to prevent anyone on the public internet from initiating payment prompts.
APP_PASSWORD=replace_with_a_long_random_password
PORT=3000
